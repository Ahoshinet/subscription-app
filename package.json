    "@types/react": "~19.2.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
